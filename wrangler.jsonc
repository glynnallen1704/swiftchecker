{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swiftchecker",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
  // The API Ninjas key is a secret, never bundled into the client:
  //   local dev  -> put it in .dev.vars   (see .dev.vars.example)
  //   production -> npx wrangler secret put API_NINJAS_KEY
}
